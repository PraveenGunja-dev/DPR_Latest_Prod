# Production build-time configuration (Vite).
# VITE_* variables are inlined into the bundle at BUILD time, so the frontend
# must be rebuilt (`npm run build`) after any change here. Setting these as
# Azure App Service application settings has NO effect on an already-built SPA.
#
# NEVER put secrets in this file - everything here ships to the browser.

# Backend API (App Service az10lappdprp02). Do NOT point this at the frontend
# host: az10lappdprp01 / digitalized-dpr.adani.com serve the SPA only and answer
# /api/* with the SPA 404 page.
# Backend API proxied via frontend server.js
VITE_API_BASE_URL=/api

# Azure Entra ID (public identifiers, not secrets). Used only by the optional
# msal-browser config; the active SSO flow is the backend web-app flow.
VITE_AZURE_TENANT_ID=04c72f56-1848-46a2-8167-8e5d36510cbc
VITE_AZURE_CLIENT_ID=588b4261-dc21-4d16-aeea-f556911432d1
