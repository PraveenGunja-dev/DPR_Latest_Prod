<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Windows App Service configuration for the built SPA.
  Vite copies everything in public/ to dist/, so this ships with the frontend ZIP.

  Why it is needed: the backend SSO callback redirects the browser to
  client-side routes such as /projects#sso_data=... and /access-pending.
  Without the rewrite below IIS looks for a matching file on disk, finds none
  and returns its own 404 page, which breaks the SSO round trip and every
  deep link / page refresh.

  On a Linux App Service this file is ignored; use the startup command
  `pm2 serve /home/site/wwwroot --no-daemon --spa` instead.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Serve real files and directories as-is (assets, images, fonts). -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- index.html points at hashed asset names that change every build,
             so the shell must never be served from cache. -->
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Hashed build output is immutable, so it is cached aggressively instead. -->
  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
