# ===================================
# Adani Flow - Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# Frontend Configuration (build time only - see frontend/.env.production)
# Leave unset for local dev so the Vite proxy handles /api.
# Azure production: https://az10lappdprp02.azurewebsites.net/api
VITE_API_BASE_URL=

# Public URL of the FRONTEND. Used for post-SSO redirects and e-mail links.
# Azure production: https://digitalized-dpr.adani.com
APP_BASE_URL=http://localhost:3316

# Public URL of the BACKEND itself. Required whenever the API is served from a
# different host than the frontend, because the Azure AD redirect_uri
# (<API_BASE_URL>/api/sso/callback) must point at the API.
# Azure production: https://az10lappdprp02.azurewebsites.net
API_BASE_URL=

# Extra allowed CORS origins, comma separated (optional; the standard
# localhost/production origins are already built into app/main.py).
CORS_ORIGINS=

# Azure Entra ID (SSO)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Oracle P6 Configuration
# Get your auth token from Oracle P6 Cloud
ORACLE_P6_AUTH_TOKEN=your_p6_auth_token_here
ORACLE_P6_BASE_URL=https://your-instance.p6.oraclecloud.com/your-tenant/p6ws/restapi

# Server Configuration
PORT=3315
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adani_flow
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ── Environment ────────────────────────────────────────────
# Decides whether the startup hardening checks run. The CODE DEFAULT IS
# "production", so a missing variable fails safe: an App Service that was never
# configured refuses to start rather than coming up on the built-in JWT keys.
#
# Set this to "development" on a local machine (as below) to relax the checks.
# Leave it at "uat"/"production" on every deployed App Service, where the
# application REFUSES to start unless:
#   - JWT_SECRET and REFRESH_TOKEN_SECRET are set, differ, and are not the
#     placeholders below, and
#   - TEST_EMAILS_OTP_EXEMPT is empty.
ENVIRONMENT=development

# JWT Configuration
# Generate secure random strings for production. They must differ from each
# other and be unique per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_secure_random_string_here
REFRESH_TOKEN_SECRET=generate_another_secure_random_string_here
# Window in which a stolen access token stays usable. The 7-day refresh token
# carries the long session and the frontend refreshes transparently on 401,
# so a short value here is not visible to users.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API documentation ────────────────────────────────────────────
# Serves /docs, /redoc and /openapi.json, and enables /api/auth/swagger-login.
# Leave false on every deployed environment: it publishes the full endpoint
# inventory, including the super-admin routes, to unauthenticated callers.
ENABLE_API_DOCS=false

# ── Security response headers ────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
# Ship a new or tightened policy as report-only for one cycle, read the
# violations out of the browser console, then set this back to false.
CSP_REPORT_ONLY=false
# Origins the SPA must reach in addition to 'self'. Required when the frontend
# and the API are separate App Services. Comma separated, no trailing slash.
# CSP_EXTRA_ORIGINS=https://az10lappdprp02.azurewebsites.net
HSTS_MAX_AGE=31536000

# ── Query-parameter token fallback ────────────────────────────────────────────
# A token in a URL is written to the proxy access log, browser history and the
# Referer header. Only these route prefixes still accept ?token=; everywhere
# else the Authorization header is required. Narrow further or empty it once
# the P6 integration is confirmed to send headers.
QUERY_TOKEN_ALLOWED_PREFIXES=/api/oracle-p6,/api/p6-token,/api/external

# ── Email / SMTP ─────────────────────────────────────────────
# The SAME server is used for OTP codes and every other notification.
# No second mail provider is introduced anywhere in the application.
# SMTP_SERVER=smtp.adani.com
# SMTP_PORT=25
# SMTP_USERNAME=no-reply-ai-agel@adani.com
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply-ai-agel@adani.com

# DEVELOPMENT ONLY. smtp.adani.com is an internal host and does not resolve
# outside the corporate network, so no OTP can be delivered off-network. Set
# both of these to write every outgoing email to a local directory instead, so
# the OTP flows can be exercised during development.
# The files contain LIVE verification codes - leave these unset in production.
# SMTP_DEV_OUTBOX_ENABLE=false
# SMTP_DEV_OUTBOX=

# ── Email-login password lifecycle ───────────────────────────
# These apply ONLY to users with authentication_type = 'EMAIL'.
# SSO users keep their Entra ID password policy and are never affected.
# Organisation policy requires 12. Mirrored in the browser at
# frontend/src/lib/passwordPolicy.ts - keep the two in step.
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=30
PASSWORD_HISTORY_COUNT=5
# Days-remaining thresholds that trigger an expiry warning.
PASSWORD_EXPIRY_WARNING_DAYS=7,3,1

# Comma-separated addresses that skip the login OTP. It is an MFA bypass list:
# an address here signs in with a password alone, at login, login verify,
# password setup and password change alike. Local development only - the code
# default is empty, and a deployed environment refuses to start if it is set.
TEST_EMAILS_OTP_EXEMPT=

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=10

# Account protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Set either of these to false ONLY as an emergency escape hatch during an SMTP
# outage: with OTP required on every email login, an unreachable mail server
# would otherwise lock every email user out. SSO users are unaffected either way.
LOGIN_REQUIRE_OTP=true
PASSWORD_SETUP_REQUIRE_OTP=true

# The 'External' role is the machine account behind /api/external/token. It has
# no inbox, so it never receives an OTP. Set this to true to also exempt it from
# the 30-day expiry and the forced password change - otherwise its credential
# must be rotated on schedule or the integration stops.
EXTERNAL_ACCOUNT_PASSWORD_EXEMPT=false

# Seconds an email user's account status is cached before the auth dependency
# re-reads it. Lower means a password expiry takes effect faster; higher means
# fewer queries per request. SSO users never trigger this lookup at all.
AUTH_STATUS_CACHE_SECONDS=60
CHALLENGE_TOKEN_EXPIRE_MINUTES=15
